// AVANTRA 2026 data model. Money is stored in paise (Int), never floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Supabase: pooler for the app, direct for migrations
}

enum Role {
  STUDENT
  SCHOOL_COORDINATOR
  JUDGE
  VOLUNTEER
  ADMIN
}

enum CodePurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  ADMIN_LOGIN
}

enum SchoolStatus {
  PENDING // registered, waiting for ARITHI admin approval
  APPROVED // shows up in the student school dropdown
  REJECTED
}

enum EventCategory {
  EXHIBITION
  TECHNOLOGY
  EXPERIENCE
  WORKSHOP
}

enum PaymentMethod {
  ONLINE // Razorpay
  OFFLINE // cash, recorded by an admin
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique // stored lowercased
  name            String
  phone           String? // collected on the profile step
  passwordHash    String? // null for Google-only accounts
  googleId        String?   @unique
  role            Role
  emailVerifiedAt DateTime? // every row is verified; kept for audit
  disabledAt      DateTime? // admin switch-off
  expiresAt       DateTime? // staff accounts stop working after this
  assignedEventId String? // judges: the one event they score
  assignedEvent   Event?    @relation("JudgeEvent", fields: [assignedEventId], references: [id])
  createdAt       DateTime  @default(now())
  student         Student?
  school          School? // set when role = SCHOOL_COORDINATOR
  sessions        Session[]
  scans           CheckIn[]
  scores          Score[]
}

// Opaque token in an httpOnly cookie; only its SHA-256 is stored. Logout = delete row.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// One live 6-digit code per email + purpose. Only an HMAC of the code is stored.
model EmailCode {
  id        String      @id @default(cuid())
  email     String
  purpose   CodePurpose
  codeHash  String
  attempts  Int         @default(0)
  expiresAt DateTime
  sentAt    DateTime    @default(now())

  @@unique([email, purpose])
}

model School {
  id            String       @id @default(cuid())
  name          String
  city          String
  address       String
  status        SchoolStatus @default(PENDING)
  coordinatorId String       @unique
  coordinator   User         @relation(fields: [coordinatorId], references: [id])
  students      Student[]
  createdAt     DateTime     @default(now())

  @@unique([name, city])
  @@index([status])
}

model Student {
  userId            String         @id
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId          String? // null = picked "Others"; admin links later
  school            School?        @relation(fields: [schoolId], references: [id])
  otherSchoolName   String? // typed when "Others" is picked
  grade             Int
  guardianEmail     String?
  guardianPhone     String
  guardianConsentAt DateTime // DPDP: verifiable parental consent for minors
  avantraId         String         @unique // human-readable, printed on badge: AV26-00123
  qrToken           String         @unique // random, opaque; what the QR encodes
  feePaidAt         DateTime? // AVANTRA registration fee (once per student). null = not a participant yet
  registrations     Registration[]
  checkIns          CheckIn[]
  payments          Payment[]

  @@index([schoolId]) // coordinator view: students of my school
}

model Event {
  id               String         @id @default(cuid())
  slug             String         @unique
  name             String
  description      String?
  registrationOpen Boolean        @default(true)
  category         EventCategory
  teamMin          Int            @default(1)
  teamMax          Int            @default(1)
  capacity         Int? // max participants; null = unlimited
  judgingCriteria  String[]       @default(["Innovation", "Scientific understanding", "Presentation", "Practical impact"]) // 0–10 each
  judges           User[]         @relation("JudgeEvent")
  registrations    Registration[]
  teams            Team[]
  checkIns         CheckIn[]
}

// A student's entry in an event. Free, but only students who paid the AVANTRA fee can register.
model Registration {
  id                  String      @id @default(cuid())
  eventId             String
  event               Event       @relation(fields: [eventId], references: [id])
  studentId           String
  student             Student     @relation(fields: [studentId], references: [userId])
  teamMember          TeamMember? // null until they create or join a team
  certificateCode     String?     @unique // set when the admin issues certificates; public verify link uses it
  certificateIssuedAt DateTime?
  createdAt           DateTime    @default(now())

  @@unique([eventId, studentId])
  @@index([studentId])
}

// Teams form between confirmed participants of one event, via invite code. Judged as a unit.
model Team {
  id           String       @id @default(cuid())
  eventId      String
  event        Event        @relation(fields: [eventId], references: [id])
  name         String
  inviteCode   String       @unique // 6 chars, leader can regenerate
  projectTitle String? // exhibition
  topic        String? // exhibition
  rank         Int? // 1, 2, 3 = winners, set by an admin after judging
  members      TeamMember[]
  scores       Score[]
  createdAt    DateTime     @default(now())

  @@index([eventId])
}

// registrationId is unique: a participant is in at most one team per event,
// and only someone registered for the event can be in its team.
model TeamMember {
  registrationId String       @id
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  teamId         String
  team           Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  isLeader       Boolean      @default(false)
  joinedAt       DateTime     @default(now())

  @@index([teamId])
}

// One row per payment attempt of the AVANTRA fee. Webhook is the source of truth for PAID.
model Payment {
  id                String        @id @default(cuid())
  studentId         String
  student           Student       @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  amountPaise       Int
  method            PaymentMethod @default(ONLINE)
  status            PaymentStatus @default(CREATED)
  razorpayOrderId   String?       @unique // null for OFFLINE
  razorpayPaymentId String?       @unique // unique = idempotent webhook handling
  recordedById      String? // OFFLINE: the admin who took the cash
  note              String? // OFFLINE: receipt number etc.
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([studentId])
}

// eventId null = main gate entry. scannedAt can be the scanner's time when an offline scan syncs later.
model CheckIn {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [userId])
  eventId     String?
  event       Event?   @relation(fields: [eventId], references: [id])
  scannedById String
  scannedBy   User     @relation(fields: [scannedById], references: [id])
  scannedAt   DateTime @default(now())

  @@index([studentId, eventId])
  @@index([eventId])
}

model Score {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  judgeId   String
  judge     User     @relation(fields: [judgeId], references: [id])
  criterion String
  points    Int
  createdAt DateTime @default(now())

  @@unique([teamId, judgeId, criterion])
}
