// AVANTRA 2026 data model. Money is stored in paise (Int), never floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Supabase: pooler for the app, direct for migrations
}

enum Role {
  STUDENT
  SCHOOL_COORDINATOR
  JUDGE
  VOLUNTEER
  ADMIN
}

enum CodePurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  ADMIN_LOGIN
}

enum SchoolStatus {
  PENDING // registered, waiting for ARITHI admin approval
  APPROVED // shows up in the student school dropdown
  REJECTED
}

enum EventCategory {
  EXHIBITION
  TECHNOLOGY
  EXPERIENCE
  WORKSHOP
}

enum RegistrationStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique // stored lowercased
  name            String
  phone           String? // collected on the profile step
  passwordHash    String? // null for Google-only accounts
  googleId        String?   @unique
  role            Role
  emailVerifiedAt DateTime? // every row is verified; kept for audit
  disabledAt      DateTime? // admin switch-off
  expiresAt       DateTime? // staff accounts stop working after this
  createdAt       DateTime  @default(now())
  student         Student?
  school          School? // set when role = SCHOOL_COORDINATOR
  sessions        Session[]
  scans           CheckIn[]
  scores          Score[]
}

// Opaque token in an httpOnly cookie; only its SHA-256 is stored. Logout = delete row.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// One live 6-digit code per email + purpose. Only an HMAC of the code is stored.
model EmailCode {
  id        String      @id @default(cuid())
  email     String
  purpose   CodePurpose
  codeHash  String
  attempts  Int         @default(0)
  expiresAt DateTime
  sentAt    DateTime    @default(now())

  @@unique([email, purpose])
}

model School {
  id            String       @id @default(cuid())
  name          String
  city          String
  address       String
  status        SchoolStatus @default(PENDING)
  coordinatorId String       @unique
  coordinator   User         @relation(fields: [coordinatorId], references: [id])
  students      Student[]
  createdAt     DateTime     @default(now())

  @@unique([name, city])
  @@index([status])
}

model Student {
  userId            String               @id
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId          String? // null = picked "Others"; admin links later
  school            School?              @relation(fields: [schoolId], references: [id])
  otherSchoolName   String? // typed when "Others" is picked
  grade             Int
  guardianEmail     String?
  guardianPhone     String
  guardianConsentAt DateTime // DPDP: verifiable parental consent for minors
  avantraId         String               @unique // human-readable, printed on badge: AV26-00123
  qrToken           String               @unique // random, opaque; what the QR encodes
  registrations     RegistrationMember[]
  checkIns          CheckIn[]

  @@index([schoolId]) // coordinator view: students of my school
}

model Event {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  category      EventCategory
  feePaise      Int            @default(0) // exhibition: 19900 per student
  teamMin       Int            @default(1)
  teamMax       Int            @default(1)
  capacity      Int?
  registrations Registration[]
  checkIns      CheckIn[]
}

// One row per team (or solo entry) in an event.
model Registration {
  id           String               @id @default(cuid())
  eventId      String
  event        Event                @relation(fields: [eventId], references: [id])
  teamName     String?
  projectTitle String? // exhibition only
  topic        String? // exhibition topic
  status       RegistrationStatus   @default(PENDING_PAYMENT)
  members      RegistrationMember[]
  payments     Payment[]
  scores       Score[]
  createdAt    DateTime             @default(now())

  @@index([eventId, status])
}

model RegistrationMember {
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student      @relation(fields: [studentId], references: [userId])
  isLeader       Boolean      @default(false)

  @@id([registrationId, studentId])
  @@index([studentId])
}

// Razorpay order per payment attempt. Webhook is the source of truth for PAID.
model Payment {
  id                String        @id @default(cuid())
  registrationId    String
  registration      Registration  @relation(fields: [registrationId], references: [id])
  amountPaise       Int
  status            PaymentStatus @default(CREATED)
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique // unique = idempotent webhook handling
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([registrationId])
}

// eventId null = main gate entry.
model CheckIn {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [userId])
  eventId     String?
  event       Event?   @relation(fields: [eventId], references: [id])
  scannedById String
  scannedBy   User     @relation(fields: [scannedById], references: [id])
  scannedAt   DateTime @default(now())

  @@index([studentId])
  @@index([eventId])
}

model Score {
  id             String       @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id])
  judgeId        String
  judge          User         @relation(fields: [judgeId], references: [id])
  criterion      String
  points         Int
  createdAt      DateTime     @default(now())

  @@unique([registrationId, judgeId, criterion])
}
