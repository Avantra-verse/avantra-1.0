# Copy to .env. Local dev values shown; prod values go in Render/Railway settings.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000            # prod: https://avantra.arithi.in

# Supabase: DATABASE_URL = pooler (port 6543, add ?pgbouncer=true), DIRECT_URL = direct (port 5432)
DATABASE_URL=postgresql://avantra:avantra@localhost:5432/avantra
DIRECT_URL=postgresql://avantra:avantra@localhost:5432/avantra
REDIS_URL=redis://localhost:6379

# 32-byte hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CODE_SECRET=

# Google sign-in (Google Cloud console > OAuth client ID, type Web). Empty = Google button disabled.
GOOGLE_CLIENT_ID=

# Email. Empty SMTP_HOST = emails are printed to the API console instead of sent.
SMTP_HOST=                                  # smtp.gmail.com
SMTP_PORT=465
SMTP_USER=                                  # noreply@arithi.in
SMTP_PASS=                                  # Google app password
MAIL_FROM="AVANTRA <noreply@arithi.in>"

# Error alerts. Empty = off.
SENTRY_DSN=

# School's own Razorpay account (money settles to SSRVM IEMS)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
